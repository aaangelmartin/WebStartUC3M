---
// Podcast: vídeo de YouTube a lo grande con el diseño encima + lista de episodios.
// `youtubeId` en el frontmatter del episodio activa el embed; sin él, el botón lleva al canal.
import { getCollection } from 'astro:content';
import { site } from '../lib/site';
const eps = (await getCollection('podcast')).sort((a, b) => b.data.episode - a.data.episode);
const latest = eps[0];
const id = (latest.data as any).youtubeId as string | undefined;
---
<section class="relative overflow-hidden bg-navy text-white">
  <div class="container-x pt-24">
    <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div>
        <span class="eyebrow text-lavender">Podcast · Start_Talks</span>
        <h2 class="display mt-3 text-[clamp(40px,7vw,96px)]" data-split>Conversaciones con gente que construye</h2>
      </div>
      <a href="/podcast" class="btn btn-on-blue">Todos los episodios <span class="font-mono">→</span></a>
    </div>
  </div>

  <div class="container-x relative mt-12 pb-24">
    <span data-parallax="20" class="display pointer-events-none absolute -top-16 right-0 select-none text-[clamp(160px,30vw,420px)] leading-none text-cobalt/40" aria-hidden="true">{String(latest.data.episode).padStart(2, '0')}</span>
    <div class="relative grid gap-8 md:grid-cols-[1.6fr_1fr]">
      <!-- Vídeo: fachada con foto; al pulsar carga el iframe de YouTube -->
      <div class="group relative aspect-video overflow-hidden rounded-brand bg-cobalt-deep" data-video={id ?? ''}>
        <img src="/media/starter.jpg" alt="" class="absolute inset-0 h-full w-full object-cover opacity-70 transition-transform duration-700 group-hover:scale-105" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-navy via-navy/30 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-6 p-6 md:p-10">
          <div>
            <span class="eyebrow text-lavender">EP {String(latest.data.episode).padStart(2, '0')} · {latest.data.duration}</span>
            <h3 class="display mt-2 max-w-xl text-[clamp(24px,3vw,44px)] tracking-[-0.02em]">{latest.data.title}</h3>
            <p class="mt-2 text-lavender">{latest.data.guest} · {latest.data.role}</p>
          </div>
          {id ? (
            <button data-play class="grid h-20 w-20 shrink-0 place-items-center rounded-full bg-white text-2xl text-cobalt transition-transform hover:scale-110" aria-label="Reproducir episodio">▶</button>
          ) : (
            <a href={site.social.youtube} class="grid h-20 w-20 shrink-0 place-items-center rounded-full bg-white text-2xl text-cobalt transition-transform hover:scale-110" aria-label="Ver en YouTube">▶</a>
          )}
        </div>
      </div>
      <ol class="flex flex-col border-t border-cobalt">
        {eps.slice(1, 5).map((e) => (
          <li><a href={`/podcast#${e.id}`} class="group flex items-start gap-5 border-b border-cobalt py-5">
            <span class="display text-3xl text-lavender/60">{String(e.data.episode).padStart(2, '0')}</span>
            <span><span class="block text-xl font-bold leading-tight group-hover:underline">{e.data.title}</span><span class="mt-1 block text-sm text-lavender">{e.data.guest} · {e.data.duration}</span></span>
          </a></li>
        ))}
      </ol>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((box) => {
    const id = box.dataset.video; if (!id) return;
    box.querySelector('[data-play]')?.addEventListener('click', () => {
      box.innerHTML = `<iframe class="absolute inset-0 h-full w-full" src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0" title="Podcast Start UC3M" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`;
    });
  });
</script>
