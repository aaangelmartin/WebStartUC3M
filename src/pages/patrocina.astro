---
import Base from '../layouts/Base.astro';
import Form from '../components/Form.astro';
import { site } from '../lib/site';
const stats = [['3.000', 'Estudiantes alcanzados por curso', 3000], ['3.000', 'Seguidores en Instagram', 2990], ['12', 'Eventos al año', 12], ['13', 'Años construyendo', 13]];
---
<Base title="Patrocina Start" description="Media kit de Start UC3M: cifras, tiers y qué obtiene tu empresa al patrocinar la asociación de emprendedores de la UC3M." tone="dark">
  <section class="bg-cobalt text-white"><div class="container-x pb-20 pt-20">
    <span class="eyebrow text-lavender">Media kit · Para empresas</span>
    <h1 class="display mt-4 max-w-5xl text-[clamp(48px,9vw,140px)]" data-split>Este año puedes estar del otro lado_</h1>
    <p class="mt-8 max-w-2xl text-xl text-lavender">Start UC3M es la puerta de entrada al talento emprendedor de la Universidad Carlos III. Patrocinar Start es estar delante de la gente que va a fundar, construir y contratar en los próximos cinco años.</p>
    <div class="mt-10 flex flex-wrap gap-3"><a href="#contacto" class="btn btn-on-blue">Hablar con Partnerships <span class="font-mono">→</span></a><a href="/dossier-startuc3m.pdf" class="btn btn-outline text-white">Descargar dossier PDF</a></div>
  </div></section>

  <section class="border-b border-line bg-paper"><div class="container-x grid gap-8 py-16 sm:grid-cols-2 md:grid-cols-4">
    {stats.map(([n, l, c]) => <div data-reveal><div class="display text-6xl text-cobalt md:text-7xl" data-count={c}>{n}</div><div class="eyebrow mt-2 opacity-70">{l}</div></div>)}
  </div></section>

  <section class="container-x grid gap-16 py-24 md:grid-cols-[1fr_1.3fr]">
    <div data-reveal><span class="eyebrow text-cobalt">Por qué Start</span><h2 class="display mt-4 text-[clamp(32px,4.5vw,64px)] text-cobalt">Talento antes de que esté en LinkedIn.</h2></div>
    <ul class="grid gap-8 sm:grid-cols-2" data-reveal>
      {[['Audiencia cualificada', 'Estudiantes de ADE, ingenierías, derecho y diseño que ya han decidido que quieren construir algo.'], ['Eventos con marca', 'Buildathon, StartXperience y Start Camp con tu naming, tu producto y tu gente dentro.'], ['Bolsa de talento', 'Acceso a los perfiles de los asistentes que lo autoricen y a los starters de cada promoción.'], ['Presencia todo el curso', 'Web, links en bio, newsletter, redes (IG, TikTok, LinkedIn, YouTube) y campus.']].map(([h, d]) => (
        <li><h3 class="text-2xl font-bold">{h}</h3><p class="mt-2 opacity-80">{d}</p></li>
      ))}
    </ul>
  </section>

  <section class="bg-navy text-white"><div class="container-x py-24">
    <span class="eyebrow text-lavender">Tiers</span>
    <h2 class="display mt-3 text-[clamp(32px,5vw,72px)]">Partner fijo o por evento_</h2>
    <p class="mt-4 max-w-xl text-lavender">Un partner fijo está dentro de Start todo el curso; el patrocinio de evento es puntual. Se pueden combinar.</p>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {site.tiers.map((t, i) => (
        <div class={`flex flex-col rounded-brand border p-8 ${i === 0 ? 'border-white bg-cobalt' : 'border-cobalt'}`} data-reveal>
          <span class="eyebrow text-lavender">{t.tag}</span>
          <h3 class="mt-3 text-3xl font-bold">{t.name}</h3>
          <p class="mt-2 text-lavender">{t.desc}</p>
          <ul class="mt-6 flex flex-col gap-2 border-t border-white/20 pt-6 text-sm">{t.perks.map((p) => <li class="flex gap-2"><span class="font-mono text-lavender">_</span>{p}</li>)}</ul>
          <a href="#contacto" class="btn btn-on-blue mt-auto pt-4 self-start mt-8">Me interesa</a>
        </div>
      ))}
    </div>
    <p class="eyebrow mt-8 text-lavender/70">Importes orientativos bajo petición · adaptamos cada colaboración</p>
  </div></section>

  <section class="container-x py-24" data-reveal>
    <span class="eyebrow text-cobalt">Eventos patrocinables</span>
    <ul class="mt-6 border-t border-line">
      {[['Buildathon', 'Septiembre · 60 personas · arranque de curso', 'Evento'], ['StartXperience', 'Abril · 300 personas · inversores e incubadoras', 'Partner / Evento'], ['Start Camp', 'Noviembre · 40 personas · 2 días', 'Evento'], ['Start_Talks (podcast)', 'Todo el curso · YouTube y Spotify', 'Partner']].map(([n, d, t]) => (
        <li class="grid gap-2 border-b border-line py-6 md:grid-cols-[1fr_1.5fr_auto] md:items-center"><span class="text-3xl font-bold">{n}</span><span class="opacity-70">{d}</span><span class="eyebrow text-cobalt">{t}</span></li>
      ))}
    </ul>
    <div class="mt-16"><span class="eyebrow text-cobalt">Ya confían en Start</span><ul class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-4">{site.sponsors.map((s) => <li class="grid aspect-[3/1.4] place-items-center rounded-brand bg-paper-2 p-6">{s.logo ? <img src={s.logo} alt={s.name} class="max-h-12 w-auto object-contain" loading="lazy" /> : <span class="text-xl font-bold uppercase tracking-wider text-cobalt">{s.name}</span>}</li>)}</ul></div>
  </section>

  <section id="contacto" class="bg-cobalt text-white"><div class="container-x grid gap-12 py-24 md:grid-cols-[1fr_1.4fr]">
    <div><span class="eyebrow text-lavender">Contacto empresas</span><h2 class="display mt-3 text-[clamp(32px,5vw,72px)]">Hablemos_</h2><p class="mt-4 text-lavender">Partnerships te responde en menos de 48 h. También en <a class="underline" href={`mailto:${site.email}`}>{site.email}</a>.</p></div>
    <Form name="patrocinio" dark submit="Enviar" fields={[
      { name: 'empresa', label: 'Empresa', required: true },
      { name: 'nombre', label: 'Persona de contacto', required: true },
      { name: 'email', label: 'Email', type: 'email', required: true },
      { name: 'interes', label: 'Interés', type: 'select', options: ['Partner fijo', 'Patrocinio de un evento', 'Colaborador (en especie)', 'Aún no lo sé'] },
      { name: 'mensaje', label: 'Mensaje', type: 'textarea', full: true, placeholder: 'Cuéntanos qué buscáis' },
    ]} />
  </div></section>
</Base>
