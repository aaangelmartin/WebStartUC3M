---
import Base from '../../layouts/Base.astro';
import Form from '../../components/Form.astro';
import { getCollection, render } from 'astro:content';
import { eventToIcs, icsDataHref } from '../../lib/ics';
export async function getStaticPaths() {
  return (await getCollection('eventos')).map((e) => ({ params: { slug: e.id }, props: { e } }));
}
const { e } = Astro.props;
const { Content } = await render(e);
const fmt = (d: Date) => d.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long' });
const open = e.data.status === 'abierto';
const soldOut = e.data.status === 'sold-out';
const icsHref = icsDataHref(eventToIcs({ title: e.data.title, description: e.data.subtitle, location: e.data.place, date: e.data.date, time: e.data.time }));
---
<Base title={e.data.title} description={e.data.subtitle} tone="dark">
  <section class="bg-cobalt text-white">
    <div class="container-x grid gap-12 pb-20 pt-20 md:grid-cols-[1.4fr_1fr] md:items-end">
      <div>
        <span class="eyebrow text-lavender">{e.data.type}</span>
        <h1 class="display mt-4 text-[clamp(44px,8vw,120px)]" data-split>{e.data.title}</h1>
        <p class="mt-6 max-w-xl text-2xl text-lavender">{e.data.subtitle}</p>
        <ul class="mt-8 flex flex-wrap gap-2">{e.data.tags.map((t) => <li class="eyebrow rounded-full border border-white/40 px-3 py-2">{t}</li>)}</ul>
      </div>
      <dl class="flex flex-col gap-5 md:text-right">
        <div><dt class="eyebrow text-lavender/70">Fecha</dt><dd class="text-2xl font-semibold capitalize">{fmt(e.data.date)} · {e.data.time}</dd></div>
        <div><dt class="eyebrow text-lavender/70">Lugar</dt><dd class="text-2xl font-semibold">{e.data.place}</dd></div>
        {e.data.sponsors.length > 0 && <div><dt class="eyebrow text-lavender/70">Con el apoyo de</dt><dd class="text-xl font-semibold">{e.data.sponsors.join(' · ')}</dd></div>}
        <div class="flex flex-wrap gap-3 md:justify-end">
          {open && <a href="#inscripcion" class="btn btn-on-blue">Reservar plaza <span class="font-mono">→</span></a>}
          <a href={icsHref} download={`${e.id}.ics`} class="btn btn-outline text-white">Añadir al calendario <span class="font-mono">＋</span></a>
        </div>
      </dl>
    </div>
  </section>
  <section class="container-x grid gap-16 py-20 md:grid-cols-[1fr_1.2fr]">
    <div class="prose prose-lg max-w-none text-ink" data-reveal><Content /></div>
    {e.data.agenda.length > 0 && (
      <ol class="border-t border-line" data-reveal>
        {e.data.agenda.map((a) => (
          <li class="grid grid-cols-[90px_1fr] gap-6 border-b border-line py-6"><span class="eyebrow pt-2 text-cobalt">{a.time}</span><div><h3 class="text-2xl font-bold">{a.title}</h3><p class="mt-1 opacity-70">{a.desc}</p></div></li>
        ))}
      </ol>
    )}
  </section>
  {open ? (
    <section id="inscripcion" class="bg-navy text-white">
      <div class="container-x py-20">
        <span class="eyebrow text-lavender">Inscripción</span>
        <h2 class="display mt-3 text-[clamp(32px,5vw,64px)]">Reserva tu plaza_</h2>
        <p class="mt-4 max-w-xl text-lavender" data-plazas-text>{e.data.seats ? `${e.data.seats} plazas.` : 'Plazas limitadas.'} Si no tienes equipo, te lo montamos allí.</p>
        <div class="mt-10 max-w-3xl">
          <input type="hidden" data-evento value={e.data.title} />
          <input type="hidden" data-evento-slug value={e.id} />
          <Form name="evento" dark submit="Reservar plaza" fields={[
            { name: 'nombre', label: 'Nombre y apellidos', required: true },
            { name: 'email', label: 'Email', type: 'email', required: true, placeholder: 'tu@alumnos.uc3m.es' },
            { name: 'grado', label: 'Grado y curso', required: true, placeholder: 'ADE · 3º' },
            { name: 'equipo', label: 'Equipo', type: 'select', options: ['No tengo equipo', 'Vengo con equipo de 2', 'Vengo con equipo de 3'] },
          ]} />
        </div>
      </div>
    </section>
  ) : soldOut ? (
    <section id="lista-espera" class="bg-navy text-white">
      <div class="container-x py-20">
        <span class="eyebrow text-lavender">Sold out</span>
        <h2 class="display mt-3 text-[clamp(32px,5vw,64px)]">Apúntate a la lista de espera_</h2>
        <p class="mt-4 max-w-xl text-lavender">Las plazas están completas. Si se libera alguna, avisamos por orden de inscripción.</p>
        <div class="mt-10 max-w-3xl">
          <input type="hidden" data-evento value={e.data.title} />
          <input type="hidden" data-espera value="si" />
          <Form name="evento" dark submit="Apuntarme a la lista de espera" fields={[
            { name: 'nombre', label: 'Nombre y apellidos', required: true },
            { name: 'email', label: 'Email', type: 'email', required: true, placeholder: 'tu@alumnos.uc3m.es' },
            { name: 'grado', label: 'Grado y curso', required: true, placeholder: 'ADE · 3º' },
          ]} />
        </div>
      </div>
    </section>
  ) : (
    <section class="container-x pb-20"><p class="eyebrow text-cobalt">Evento pasado</p></section>
  )}
</Base>
<script>
  // Añade el nombre del evento, su slug (para el conteo de plazas) y si es lista de espera al envío del formulario
  const ev = document.querySelector<HTMLInputElement>('[data-evento]');
  const slug = document.querySelector<HTMLInputElement>('[data-evento-slug]');
  const espera = document.querySelector<HTMLInputElement>('[data-espera]');
  const form = document.querySelector<HTMLFormElement>('form[data-form="evento"]');
  const addHidden = (name: string, value: string) => { const i = document.createElement('input'); i.type = 'hidden'; i.name = name; i.value = value; form!.appendChild(i); };
  if (ev && form) addHidden('evento', ev.value);
  if (slug && form) addHidden('slug', slug.value);
  if (espera && form) addHidden('tipo', 'lista-espera');

  // Plazas en vivo: solo tiene sentido en la sección de inscripción abierta (con data-evento-slug y sin lista de espera)
  const plazasText = document.querySelector<HTMLElement>('[data-plazas-text]');
  if (slug && plazasText && !espera) {
    fetch(`/api/eventos/${slug.value}/plazas`)
      .then((r) => r.json())
      .then((p: { seats: number | null; remaining: number | null }) => {
        if (p.remaining == null) return;
        if (p.remaining > 0) {
          plazasText.textContent = `${p.remaining} de ${p.seats} plazas libres. Si no tienes equipo, te lo montamos allí.`;
        } else {
          plazasText.textContent = 'Plazas completas por ahora.';
          const submit = form?.querySelector<HTMLButtonElement>('button');
          if (submit) { submit.disabled = true; submit.classList.add('opacity-50', 'cursor-not-allowed'); submit.textContent = 'Plazas completas'; }
        }
      })
      .catch(() => {});
  }
</script>
