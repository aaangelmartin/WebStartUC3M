---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { getCollection } from 'astro:content';
const all = (await getCollection('eventos')).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const next = all.filter((e) => e.data.status !== 'pasado');
const past = all.filter((e) => e.data.status === 'pasado').reverse();
const fmt = (d: Date) => d.toLocaleDateString('es-ES', { day: '2-digit', month: 'short' }).toUpperCase();
---
<Base title="Eventos" tone="dark">
  <PageHead eyebrow="Eventos" title="Una tarde para construir, no para escuchar" intro="Buildathon, hackathones, StartXperience, Start Camp. Todo lo que organizamos este curso, con inscripción integrada." />
  <section class="container-x py-20">
    <span class="eyebrow text-cobalt">Próximos</span>
    <ul class="mt-6 border-t border-line">
      {next.map((e) => (
        <li data-reveal><a href={`/eventos/${e.id}`} class="group grid gap-4 border-b border-line py-8 md:grid-cols-[120px_1fr_auto] md:items-center">
          <span class="display text-4xl text-cobalt">{fmt(e.data.date)}</span>
          <div><h2 class="text-3xl font-bold group-hover:underline md:text-4xl">{e.data.title}</h2><p class="mt-1 opacity-70">{e.data.subtitle} · {e.data.place}</p></div>
          <span class={`eyebrow rounded-full border px-3 py-2 ${e.data.status === 'sold-out' ? 'border-ink' : 'border-cobalt text-cobalt'}`}>{e.data.status === 'sold-out' ? 'Sold out' : 'Inscripción abierta'}</span>
        </a></li>
      ))}
    </ul>
    <span class="eyebrow mt-20 block text-cobalt">Pasados</span>
    <ul class="mt-6 grid gap-8 md:grid-cols-2">
      {past.map((e) => (
        <li data-reveal><a href={`/eventos/${e.id}`} class="group block rounded-brand bg-paper-2 p-8">
          <span class="eyebrow text-cobalt">{e.data.type} · {fmt(e.data.date)} {e.data.date.getFullYear()}</span>
          <h2 class="mt-3 text-3xl font-bold group-hover:underline">{e.data.title}</h2><p class="mt-2 opacity-70">{e.data.subtitle}</p>
        </a></li>
      ))}
    </ul>
  </section>
</Base>
