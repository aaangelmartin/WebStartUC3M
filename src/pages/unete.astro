---
import Base from '../layouts/Base.astro';
import Form from '../components/Form.astro';
import { site } from '../lib/site';
---
<Base title="Únete a Start" tone="dark">
  <section class="bg-cobalt text-white"><div class="container-x grid gap-12 pb-20 pt-20 md:grid-cols-[1fr_1.2fr]">
    <div>
      <span class="eyebrow text-lavender">Inscripciones abiertas · {site.course}</span>
      <h1 class="display mt-4 text-[clamp(44px,7vw,104px)]" data-split>Quiero entrar en Start_</h1>
      <p class="mt-6 max-w-lg text-xl text-lavender">Buscamos perfiles comprometidos, con mentalidad abierta y espíritu colaborativo. Cuanto más aportas, más crece tu recorrido dentro y fuera de Start.</p>
      <ol class="mt-10 flex flex-col gap-4 border-t border-white/30 pt-6">
        {['Vienes al Buildathon y nos conoces trabajando', 'Hablamos de los departamentos y de qué te encaja', 'Te apuntas al proceso de entrada'].map((s, i) => <li class="flex gap-4"><span class="font-mono text-lavender">0{i + 1}_</span><span class="text-lg">{s}</span></li>)}
      </ol>
    </div>
    <Form name="unete" dark submit="Apuntarme a Start" fields={[
      { name: 'nombre', label: 'Nombre y apellidos', required: true },
      { name: 'email', label: 'Email UC3M', type: 'email', required: true, placeholder: 'tu@alumnos.uc3m.es' },
      { name: 'grado', label: 'Grado y curso', required: true, placeholder: 'Ingeniería Informática · 2º' },
      { name: 'departamento', label: 'Departamento que te interesa', type: 'select', options: ['No lo sé aún', ...site.departments.map((d) => d.name)] },
      { name: 'linkedin', label: 'LinkedIn (opcional)', placeholder: 'https://linkedin.com/in/…' },
      { name: 'motivo', label: '¿Por qué quieres entrar en Start?', type: 'textarea', full: true, required: true },
    ]} />
  </div></section>
</Base>
