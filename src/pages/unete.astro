---
import Base from '../layouts/Base.astro';
import Form from '../components/Form.astro';
import { site } from '../lib/site';
// [COPY] Álvaro revisa; la estructura la fija Ángel
const ways = [
  { t: 'Ven a los eventos', d: 'Buildathon, hackathones, StartXperience, Start Camp. Abiertos a toda la UC3M, sin ser socio.', img: '/media/starter.jpg', cta: ['Ver eventos', '/eventos'] },
  { t: 'Entra en la comunidad', d: 'Newsletter, grupo y podcast: entérate de todo lo que pasa en el ecosistema desde dentro.', img: '/media/location.jpg', cta: ['Suscribirme', '#newsletter'] },
  { t: 'Forma parte de Start', d: 'Únete a un departamento y organiza con nosotros. Es la forma de aprender construyendo.', img: '/media/equipo/alicia_gascon.jpg', cta: ['Apuntarme', '#formulario'] },
];
const perks = ['Equipo multidisciplinar: ADE, ingenierías, derecho, diseño', 'Contacto directo con fundadores, inversores y empresas', 'Organizas eventos de 60 a 300 personas', 'Red de alumni que fundan, invierten y contratan', 'Formaciones internas cada curso', 'Y sí: sangriadas'];
---
<Base title="Únete a Start" tone="dark">
  <section class="bg-cobalt text-white"><div class="container-x pb-16 pt-20">
    <span class="eyebrow text-lavender">Únete · Curso {site.course}</span>
    <h1 class="display mt-4 max-w-5xl text-[clamp(48px,9vw,140px)]" data-split>Hay un sitio para ti en Start_</h1>
    <p class="mt-8 max-w-2xl text-xl text-lavender">Vengas de la carrera que vengas y tengas idea o no. Puedes venir a un evento, seguir la comunidad o entrar en el equipo. Tres puertas, la que quieras.</p>
  </div></section>

  <section class="container-x py-20">
    <div class="grid gap-8 md:grid-cols-3">
      {ways.map((w, i) => (
        <a href={w.cta[1]} class="group flex flex-col" data-reveal>
          <div class="relative aspect-[4/5] overflow-hidden rounded-brand bg-cobalt"><img src={w.img} alt="" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" /><span class="display absolute left-5 top-4 text-6xl text-white">0{i + 1}</span></div>
          <h2 class="mt-5 text-3xl font-bold group-hover:underline">{w.t}</h2>
          <p class="mt-2 opacity-80">{w.d}</p>
          <span class="mono mt-4 text-cobalt">{w.cta[0]} →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="bg-navy text-white"><div class="container-x grid gap-12 py-24 md:grid-cols-[1fr_1.2fr] md:items-center">
    <div data-reveal>
      <span class="eyebrow text-lavender">Ser starter</span>
      <h2 class="display mt-3 text-[clamp(32px,5vw,72px)]">Lo que te llevas_</h2>
      <p class="mt-4 max-w-md text-lavender">Buscamos perfiles comprometidos, con mentalidad abierta y espíritu colaborativo. Cuanto más aportas, más crece tu recorrido dentro y fuera de Start.</p>
    </div>
    <ul class="grid gap-x-8 border-t border-cobalt sm:grid-cols-2" data-reveal>
      {perks.map((p) => <li class="flex gap-3 border-b border-cobalt py-4"><span class="font-mono text-lavender">_</span><span class="text-lg">{p}</span></li>)}
    </ul>
  </div></section>

  <section class="container-x grid gap-12 py-24 md:grid-cols-[1fr_1.4fr]">
    <div data-reveal>
      <span class="eyebrow text-cobalt">Departamentos</span>
      <h2 class="display mt-3 text-[clamp(32px,4vw,56px)] text-cobalt">Dónde encajas_</h2>
      <ul class="mt-6 border-t border-line">{site.departments.map((d) => <li class="border-b border-line py-3"><span class="font-bold">{d.name}</span> <span class="text-sm opacity-70">· {d.short}</span></li>)}</ul>
    </div>
    <div id="formulario" class="rounded-brand bg-cobalt p-8 text-white md:p-12" data-reveal>
      <span class="eyebrow text-lavender">Proceso de entrada</span>
      <h2 class="display mt-3 text-[clamp(28px,3.5vw,48px)]">Quiero entrar en Start_</h2>
      <ol class="mt-6 flex flex-col gap-2 text-lavender">
        {['Vienes al Buildathon y nos conoces trabajando', 'Hablamos de los departamentos y de qué te encaja', 'Rellenas esto y te escribimos'].map((s, i) => <li class="flex gap-3"><span class="font-mono">0{i + 1}_</span>{s}</li>)}
      </ol>
      <div class="mt-8">
        <Form name="unete" dark submit="Apuntarme a Start" fields={[
          { name: 'nombre', label: 'Nombre y apellidos', required: true },
          { name: 'email', label: 'Email UC3M', type: 'email', required: true, placeholder: 'tu@alumnos.uc3m.es' },
          { name: 'grado', label: 'Grado y curso', required: true, placeholder: 'Ingeniería Informática · 2º' },
          { name: 'departamento', label: 'Departamento que te interesa', type: 'select', options: ['No lo sé aún', ...site.departments.map((d) => d.name)] },
          { name: 'motivo', label: '¿Por qué quieres entrar en Start?', type: 'textarea', full: true, required: true },
        ]} />
      </div>
    </div>
  </section>
</Base>
