---
import Base from '../layouts/Base.astro';
---
<Base title="404" tone="dark">
  <section class="bg-cobalt text-white"><div class="container-x flex min-h-[70vh] flex-col justify-center py-20">
    <span class="eyebrow text-lavender">Error 404</span>
    <h1 class="display mt-4 text-[clamp(64px,16vw,240px)]">404_</h1>
    <p class="mt-6 max-w-md text-xl text-lavender">Esta página no existe todavía. Como casi todo en Start: se construye.</p>
    <a href="/" class="btn btn-on-blue mt-8 self-start">Volver al inicio <span class="font-mono">→</span></a>
  </div></section>
</Base>
