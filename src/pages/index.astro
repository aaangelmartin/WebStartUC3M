---
import Base from '../layouts/Base.astro';
import PodcastTrack from '../components/PodcastTrack.astro';
import { getCollection } from 'astro:content';
import { site } from '../lib/site';
const eventos = (await getCollection('eventos')).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const next = eventos.find((e) => e.data.status !== 'pasado')!;
const posts = (await getCollection('blog')).filter((p) => !p.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long' });
---
<Base tone="dark">
  <!-- HERO: azul principal, titular monumental -->
  <section class="bg-cobalt text-white">
    <div class="container-x flex min-h-[calc(100vh-72px)] flex-col justify-between pb-12 pt-16">
      <span class="eyebrow inline-flex w-fit max-w-full items-center gap-2 rounded-full border border-white/40 px-3 py-2 text-lavender normal-case"><span class="h-1.5 w-1.5 rounded-full bg-white"></span>Inscripciones abiertas · Curso {site.course}</span>
      <h1 class="display my-10 text-[clamp(56px,11vw,168px)]" data-split>Piensa diferente, actúa con propósito_</h1>
      <div class="grid gap-10 md:grid-cols-[1fr_auto] md:items-end">
        <div class="max-w-xl">
          <p class="text-xl leading-snug text-lavender md:text-2xl">La asociación de emprendedores de la Universidad Carlos III de Madrid. Eventos, comunidad y proyectos para pasar de la idea a algo real.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/unete" class="btn btn-on-blue">Apuntarme a Start <span class="font-mono">→</span></a>
            <a href="/eventos" class="btn btn-outline text-white">Ver eventos</a>
          </div>
          <p class="eyebrow mt-6 text-lavender/70">Plazas limitadas · Abierto a toda la UC3M</p>
        </div>
        <div class="flex flex-wrap gap-6 md:gap-10">
          {[['2013', 'Desde', 2013], ['8', 'Departamentos', 8], ['3.000', 'Comunidad', 3000]].map(([n, l, c]) => (
            <div class="border-l-2 border-white/40 pl-4">
              <div class="display text-5xl md:text-6xl" data-count={c}>{n}</div>
              <div class="eyebrow mt-1 text-lavender/80">{l}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- TICKER -->
  <div class="overflow-hidden border-y border-line bg-paper py-5 text-ink">
    <div class="ticker">
      {[...site.sponsors, 'EFE Emprende', ...site.sponsors, 'EFE Emprende'].map((s) => (
        <span class="flex items-center gap-16 text-xl font-bold uppercase tracking-wider">{s}<span class="font-mono text-cobalt">_</span></span>
      ))}
    </div>
  </div>

  <!-- PRÓXIMO EVENTO -->
  <section class="bg-navy text-white">
    <div class="container-x py-24">
      <div class="grid gap-12 md:grid-cols-[1.4fr_1fr] md:items-end" data-reveal>
        <div>
          <span class="eyebrow text-lavender">Próximo evento · {next.data.type}</span>
          <h2 class="display mt-4 text-[clamp(44px,7vw,96px)]">{next.data.title}</h2>
          <p class="mt-6 max-w-xl text-xl text-lavender">{next.data.subtitle}.</p>
        </div>
        <dl class="flex flex-col gap-5 md:items-end md:text-right">
          {[['Fecha', `${fmt(next.data.date)} · ${next.data.time}`], ['Lugar', next.data.place], ['Plazas', next.data.seats ? `${next.data.seats} · equipos de 3` : 'Limitadas']].map(([k, v]) => (
            <div><dt class="eyebrow text-lavender/70">{k}</dt><dd class="text-2xl font-semibold">{v}</dd></div>
          ))}
          <a href={`/eventos/${next.id}`} class="btn btn-on-blue mt-2">Reservar plaza <span class="font-mono">→</span></a>
        </dl>
      </div>
      <div class="mt-16 grid gap-8 border-t border-cobalt pt-8 md:grid-cols-3" data-reveal>
        {next.data.agenda.map((a) => (
          <div>
            <span class="eyebrow text-lavender">{a.time}</span>
            <h3 class="mt-2 text-3xl font-bold">{a.title}</h3>
            <p class="mt-2 text-lavender/90">{a.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- QUÉ ES START -->
  <section class="bg-paper text-ink">
    <div class="container-x grid gap-16 py-28 md:grid-cols-[1fr_1.4fr]" data-reveal>
      <div>
        <span class="eyebrow text-cobalt">¿Quiénes somos?</span>
        <h2 class="display mt-4 text-[clamp(36px,4.5vw,64px)] text-cobalt">De la idea a algo real, antes de terminar la carrera.</h2>
      </div>
      <div>
        <p class="max-w-2xl text-xl leading-relaxed md:text-2xl">Start UC3M nació en 2013 cuando seis alumnos de ADE se dieron cuenta de que en la universidad faltaba una iniciativa que conectara el talento técnico, de diseño y de negocio. Desde entonces organizamos eventos, hackathones y talleres para que los estudiantes pasen de ideas a proyectos.</p>
        <ul class="mt-10 grid border-t border-line sm:grid-cols-2 sm:gap-x-8">
          {site.departments.map((d) => (
            <li class="flex items-baseline gap-3 border-b border-line py-4"><span class="text-lg font-bold text-cobalt">{d.name}</span><span class="text-sm opacity-70">{d.short}</span></li>
          ))}
        </ul>
        <a href="/equipo" class="btn btn-primary mt-8">Conoce al equipo <span class="font-mono">→</span></a>
      </div>
    </div>
  </section>

  <PodcastTrack />

  <!-- STARTER -->
  <section class="bg-paper text-ink">
    <div class="container-x grid gap-12 py-28 md:grid-cols-[1fr_1.2fr] md:items-end" data-reveal>
      <div class="aspect-[4/5] rounded-brand bg-cobalt-deep" aria-hidden="true"></div>
      <div>
        <span class="eyebrow text-cobalt">¿Qué es un starter?</span>
        <h2 class="display mt-4 text-[clamp(36px,5vw,72px)] text-cobalt">Un starter no es solo alguien que forma parte de Start_</h2>
        <p class="mt-6 max-w-xl text-lg leading-relaxed">Es una persona con iniciativa, curiosidad y ganas reales de implicarse. Alguien que aporta ideas, energía y actitud a la comunidad, y que entiende que el valor de Start lo construimos entre todos. Cuanto más aportas, más crece tu recorrido dentro y fuera de Start.</p>
        <a href="/unete" class="btn btn-primary mt-8">Quiero entrar en Start <span class="font-mono">→</span></a>
      </div>
    </div>
  </section>

  <!-- BLOG -->
  <section class="bg-paper-2 text-ink">
    <div class="container-x py-24" data-reveal>
      <div class="flex items-end justify-between">
        <div><span class="eyebrow text-cobalt">Blog</span><h2 class="display mt-3 text-[clamp(32px,4vw,56px)]">Lo último de la comunidad</h2></div>
        <a href="/blog" class="btn btn-outline hidden md:inline-flex">Ver todos los posts</a>
      </div>
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        {posts.map((p) => (
          <a href={`/blog/${p.id}`} class="group">
            <div class="aspect-[16/10] rounded-brand bg-cobalt transition-transform group-hover:-translate-y-1"></div>
            <span class="eyebrow mt-4 block text-cobalt">{p.data.category} · {p.data.date.toLocaleDateString('es-ES', { day: 'numeric', month: 'short' })}</span>
            <h3 class="mt-2 text-2xl font-bold leading-tight group-hover:underline">{p.data.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PATROCINA -->
  <section class="bg-cobalt text-white">
    <div class="container-x grid gap-16 py-28 md:grid-cols-[1.3fr_1fr] md:items-center" data-reveal>
      <div>
        <span class="eyebrow text-lavender">Para empresas</span>
        <h2 class="display mt-4 text-[clamp(40px,6vw,88px)]">Este año puedes estar del otro lado_</h2>
        <p class="mt-6 max-w-xl text-lg text-lavender">Patrocina un evento o el curso completo y llega a más de 3.000 estudiantes de la UC3M que quieren construir. Media kit, tiers y cifras en una página.</p>
        <a href="/patrocina" class="btn btn-on-blue mt-8">Ver media kit <span class="font-mono">→</span></a>
      </div>
      <ul class="border-t border-white/30">
        {site.tiers.map((t) => (
          <li class="flex items-center justify-between gap-6 border-b border-white/30 py-5"><span class="text-2xl font-bold">{t.name}</span><span class="text-right text-sm text-lavender">{t.desc}</span></li>
        ))}
      </ul>
    </div>
  </section>
</Base>
